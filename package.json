{
  "name": "agent-mv-studio",
  "version": "0.1.0",
  "description": "Deterministic, frame-by-frame music-video studio for AI agents: two fixed styles (three-ink plate / terminal pane), a storyboard compiler, a pure f(t) renderer and a QA harness.",
  "keywords": [
    "music-video",
    "generative-art",
    "canvas",
    "ffmpeg",
    "playwright",
    "storyboard",
    "agent",
    "deterministic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShingStars/agent-mv-studio.git"
  },
  "homepage": "https://github.com/ShingStars/agent-mv-studio#readme",
  "bugs": {
    "url": "https://github.com/ShingStars/agent-mv-studio/issues"
  },
  "type": "module",
  "license": "MIT",
  "bin": {
    "agent-mv": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist",
    "templates",
    "assets",
    "docs",
    "README.md",
    "LICENSE",
    "CREDITS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/source-serif-4": "^5.2.5",
    "playwright-core": "^1.55.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
